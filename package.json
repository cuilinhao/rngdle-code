{
  "name": "rngdle-art",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data": "node scripts/build-data.mjs",
    "build": "npm run data && npm run data:seo && tsc -b && vite build && vite build --ssr scripts/ssr.tsx --outDir .prerender --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -b",
    "data:seo": "node scripts/build-seo-data.mjs && node scripts/build-social-images.mjs",
    "test:seo": "node --test tests/seo/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
